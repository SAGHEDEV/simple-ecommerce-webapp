PORT=4010
JWT_SECRET=change-me
# Comma-separated allowed origins (first one is used for redirects)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# MySQL connection (create the database first – see README)
DB_HOST=localhost
DB_PORT=3306
DB_USER=furniro_user
DB_PASSWORD=
DB_NAME=furniro

# Paid orders are marked "Delivered" automatically after this many minutes (there is no admin).
DELIVERY_DELAY_MINUTES=3
